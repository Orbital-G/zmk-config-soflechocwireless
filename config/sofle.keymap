#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        mo1_orange: mo1_orange {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,30)>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,10,30)>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  | 1(!)| 2(@)| 3(#) | 4($) | 5(%) |                        | 6(^)| 7(&)|  8(*)| 9(() |  0()) | bkspc |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                        |  Y  |  U  |   I  |   O  |   P   |  =(+) |
// |Control|  A  |  S  |  D   |  F   |  G   |                        |  H  |  J  |   K  |   L  |  ;(:) | Enter |
// |  Opt  |  Z  |  X  |  C   |  V   |  B   |  \(|) |         |LAYER1|  N  |  M  | ,(<) | .(>) |  /(?) |  -(_) |
//               |LAYER1|LSHIFT| Com  |SPACE| ENG  |           | JPN  | Com | RSHIFT | `(~) | '(") |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3      &kp N4      &kp N5                               &kp N6  &kp N7   &kp N8    &kp N9   &kp N0    &kp BSPC
&kp TAB   &kp Q  &kp W    &kp E       &kp R       &kp T                                &kp Y   &kp U    &kp I     &kp O    &kp P     &kp EQUAL
&kp LCTRL &kp A  &kp S    &kp D       &kp F       &kp G                                &kp H   &kp J    &kp K     &kp L    &kp SEMI  &kp RET
&kp LALT  &kp Z  &kp X    &kp C       &kp V       &kp B   &kp BSLH     &mo1_orange     &kp N   &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp MINUS
                 &mo1_orange  &kp LSHIFT  &kp LGUI  &kp SPACE &kp F13    &kp F14  &kp RGUI &kp RSHIFT &kp GRAVE &kp SQT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  | BT0  | BT1  |  BT2 |  BT3 | BT4 |                  | PGUP |   7  |   8   |   9  |       |     |
// |  TAB  |      |   7  |   8  |   9  |     |                  | PGDW |  4   |   5   |   6  |       |     |
// |Control|      |   4  |   5  |   6  |     |                  |  <-  |  v   |   ^   |  ->  |       |     |
// |  Opt  |      |   1  |   2  |   3  |     | BTCLR |  | [({)  | ](}) |   1  |   2   |   3  |   0   |     |
//                |   0  |LSHIFT|     |SPACE |  ENG  |  | JPN   |      |LSHIFT|       |      |
            bindings = <
&kp ESC   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                    &kp PG_UP &kp KP_N7 &kp KP_N8 &kp KP_N9 &trans &trans
&kp TAB   &trans       &kp KP_N7    &kp KP_N8    &kp KP_N9    &trans                          &kp PG_DN &kp KP_N4 &kp KP_N5 &kp KP_N6 &trans &trans
&kp LCTRL &trans       &kp KP_N4    &kp KP_N5    &kp KP_N6    &trans                          &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans &trans
&kp LALT  &trans       &kp KP_N1    &kp KP_N2    &kp KP_N3    &trans    &bt BT_CLR  &kp LBKT  &kp RBKT  &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N0 &trans
                       &kp KP_N0   &kp LSHFT    &trans       &kp SPACE &kp F13     &kp F14   &trans    &kp LSHFT &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};

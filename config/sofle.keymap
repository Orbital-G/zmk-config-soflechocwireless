#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    macros {
        mo1_orange: mo1_orange {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &mo 1>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,100,30)>
                , <&macro_pause_for_release>
                    , <&macro_release &mo 1>
                    , <&macro_tap &rgb_ug RGB_COLOR_HSB(30,10,30)>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |  ESC  | 1(!)| 2(@)| 3(#) | 4($) | 5(%) |                         | 6(^) | 7(&) | 8(*)  | 9(() |  0()) |  \(|) |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                         |  Y   |  U   |  I    |  O   |   P   |  =(+) |
// |Control|  A  |  S  |  D   |  F   |  G   |                         |  H   |  J   |  K    |  L   |  ;(:) | `(~)  |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | Alt |           | bkspc |  N   |  M   | ,(<)  | .(>) |  /(?) | -(_)  |
//               | opt | Com  |LAYER1| Eng  | SPACE |         | ENTER | Jpn  | Com  | SHIFT | '(") |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3      &kp N4      &kp N5                            &kp N6  &kp N7   &kp N8    &kp N9   &kp N0    &kp BSLH
&kp TAB   &kp Q  &kp W    &kp E       &kp R       &kp T                             &kp Y   &kp U    &kp I     &kp O    &kp P     &kp EQUAL
&kp LCTRL &kp A  &kp S    &kp D       &kp F       &kp G                             &kp H   &kp J    &kp K     &kp L    &kp SEMI  &kp GRAVE
&kp LSHFT &kp Z  &kp X    &kp C       &kp V       &kp B  &kp LALT     &kp BSPC     &kp N   &kp M    &kp COMMA &kp DOT  &kp FSLH  &kp MINUS
                 &kp LALT &kp LGUI    &mo1_orange &kp F13 &kp SPACE   &kp RET      &kp F14 &kp RGUI &kp RSHFT &kp SQT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       | -(=) |  ^(~) | ¥(|) |
// |     | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   | @(`) |  ;(+) | [({) |
// |     | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  :(*) | ](}) |
// |     | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      | ,(<)  | .(>) |  /(?) |   _  |
//              |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4             &trans    &trans    &trans    &kp MINUS &kp GRAVE &kp BSLH
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                   &kp PG_UP &trans    &kp UP    &kp LBKT  &kp SEMI  &kp RBKT
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                 &kp PG_DN &kp LEFT  &kp DOWN  &kp RIGHT &kp SQT   &kp RBRC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans  &trans   &trans  &trans    &trans    &kp COMMA &kp DOT   &kp FSLH  &kp UNDER
                        &trans       &trans       &trans       &trans  &trans   &trans  &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
